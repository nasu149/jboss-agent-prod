# Print LangGraph state and node updates to the terminal when enabled.
LANGGRAPH_DEBUG=false

# Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Microsoft Teams notification. Keep true to inspect the payload without network access.
TEAMS_DRY_RUN=true
TEAMS_WEBHOOK_URL=

# Fake target shared by the Streamlit process and the stdio MCP server process.
SERVER_ID=jboss-01
FAKE_JBOSS_DATA_DIR=.data/fake_jboss
