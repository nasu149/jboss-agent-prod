# Required: Gemini Developer API
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=1.0

# Optional: Microsoft Teams incoming webhook.
# Keep true while learning; no network notification is sent.
TEAMS_DRY_RUN=true
TEAMS_WEBHOOK_URL=

# Demo target
SERVER_ID=jboss-01
FAKE_JBOSS_DATA_DIR=.data/fake_jboss

# Durable LangGraph/UI state
CHECKPOINT_DB_PATH=.data/checkpoints.sqlite
RUNTIME_DB_PATH=.data/runtime.sqlite
SIMULATOR_DB_PATH=.data/simulator.sqlite

# Safety limits
MAX_INVESTIGATION_ROUNDS=5
MAX_RECOVERY_ATTEMPTS=2
